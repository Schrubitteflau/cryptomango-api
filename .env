# Production database
MONGO_DATABASE_URL=mongodb://localhost:27017/cryptomango

# Database used for running tests in a real and controlled environment
TESTING_MONGO_DATABASE_URL=mongodb://localhost:27017/testing

# "api_only" | "api_sync" | "fast_sync_no_api"
APP_MODE=api_sync

# Listening port of the API
API_PORT=8000

# Secret key used to sign the JWT tokens
JWT_SECRET=secret

THROW_RANDOM_ERRORS=false
# A value of "1" gives 1/10, a value of "2" 2/10, etc.
THROW_RANDOM_ERRORS_RATE=1
