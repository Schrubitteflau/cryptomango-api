{
  "name": "cryptomango-api",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "test": "jest",
    "build-scripts": "npx tsc scripts/*.ts",
    "gen-contracts-types": "npx typechain --target=ethers-v5 --out-dir 'src/EVM/Contracts' 'ABIs/**/*.json'",
    "prod": "npx tsc && node -r module-alias/register -r dotenv-flow/config dist/index.js",
    "dev": "concurrently -k -n \"Typescript,Node\" -p \"${npm_package_name}\" -c \"blue,green\" \"npx tsc --watch\" \"nodemon -r dotenv-flow/config ${npm_package_main}\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cryptomangoFi/cryptomango-api.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/cryptomangoFi/cryptomango-api/issues"
  },
  "homepage": "https://github.com/cryptomangoFi/cryptomango-api#readme",
  "dependencies": {
    "cors": "^2.8.5",
    "dateformat": "^4.5.1",
    "dotenv-flow": "^3.2.0",
    "ethers": "^5.4.1",
    "express": "^4.17.1",
    "express-async-errors": "^3.1.1",
    "express-jwt": "^6.1.0",
    "jsonwebtoken": "^8.5.1",
    "module-alias": "^2.2.2",
    "mongodb": "^3.6.6",
    "mongoose": "^6.0.13",
    "mongoose-unique-validator": "^3.0.0",
    "node-fetch": "^2.6.1",
    "uuid": "^8.3.2",
    "validator": "^13.7.0"
  },
  "devDependencies": {
    "@typechain/ethers-v5": "^7.0.1",
    "@types/cors": "^2.8.12",
    "@types/dateformat": "^3.0.1",
    "@types/express": "^4.17.11",
    "@types/express-jwt": "^6.0.2",
    "@types/jest": "^27.0.2",
    "@types/jsonwebtoken": "^8.5.6",
    "@types/mongodb": "^3.6.12",
    "@types/mongoose": "^5.11.97",
    "@types/node": "^15.3.0",
    "@types/node-fetch": "^2.5.10",
    "@types/uuid": "^8.3.3",
    "@types/validator": "^13.7.0",
    "cheerio": "^1.0.0-rc.10",
    "concurrently": "^6.1.0",
    "jest": "^27.3.1",
    "nodemon": "^2.0.7",
    "ts-jest": "^27.0.7",
    "typechain": "^5.1.2",
    "typescript": "^4.2.4"
  },
  "_moduleAliases": {
    "@EVM": "dist/EVM",
    "@Formatters": "dist/Formatters",
    "@Networks": "dist/Networks",
    "@Repositories": "dist/Repositories",
    "@Schemas": "dist/Database/Schemas",
    "@Services": "dist/Services",
    "@Types": "dist/Repositories",
    "@Util": "dist/Util",
    "@Database": "dist/Database",
    "@Models": "dist/Database/Models",
    "@API": "dist/API"
  }
}
