{
    "compilerOptions": {
        "outDir": "dist",
        "target": "es6",
        "strict": true,
        "moduleResolution": "node",
        "module": "commonjs",
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "strictNullChecks": true,
        "lib": [ "ES2020.String" ],
        "baseUrl": "./src",
        "typeRoots": [ "@types", "./node_modules/@types" ],
        "paths": {
            "@EVM/*": [ "EVM/*" ],
            "@Formatters": [ "Formatters/index.ts" ],
            "@Networks": [ "Networks/index.ts" ],
            "@Repositories": [ "Database/Repositories/index.ts" ],
            "@Schemas": [ "Database/Schemas/index.ts" ],
            "@NetworkServices": [ "NetworkServices/index.ts" ],
            "@Types/*": [ "Types/*" ],
            "@Types": [ "Types/index.ts" ],
            "@Util": [ "Util/index.ts" ],
            "@Util/*": [ "Util/*" ],
            "@Database/init": [ "Database/init.ts" ],
            "@Models": [ "Database/Models/index.ts" ],
            "@API/*": [ "API/*" ],
            "@Config": [ "Config/index.ts" ],
            "@ModelFactories": [ "Database/ModelFactories/index.ts" ]
        }
    },
    "include": [
        "src/**/*",
        "environment.d.ts"
    ]
}