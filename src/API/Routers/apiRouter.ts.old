import express from "express";

import { StrictContractType } from "@EVM/BytecodeAnalyzer";
import { Network } from "@Networks";
import { RequestWithQuery, ResponseWithLocals } from "@Types/Express";

import { jwtMiddleware, userSessionMiddleware, IUserSessionResponseLocals } from "../Middlewares";
import { isNull } from "@Util";

interface IGetNextTokensQuery
{
    network: number;
    contractType: StrictContractType;
}

interface IFollowTokenQuery
{
    network: number;
    contractType: StrictContractType;
    address: string;
}

interface IDismissTokenQuery
{
    network: number;
    contractType: StrictContractType;
    address: string;
}

export const apiRouter: express.Router = express.Router();

apiRouter
    .use(jwtMiddleware)
    .use(userSessionMiddleware)

