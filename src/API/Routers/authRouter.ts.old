import express from "express";
import { sign as jwtSign } from "jsonwebtoken";
import { v4 as uuidv4 } from "uuid";

import { UserSession, UserSessionFactory, userSessionsManager } from "@API/Users";
import { getGlobalRepository, UserRepository } from "@Repositories";
import { IUser } from "@Schemas";
import { FlushResult, ValidationResult } from "Database/Repositories/AbstractRepository";
import { HydratedDocument } from "mongoose";
import { isNull } from "@Util";

export interface IJwtBody
{
    userId: string;
    iat: number;
    exp: number;
    jti: string;
}

export const authRouter: express.Router = express.Router();
const userRepository: UserRepository = getGlobalRepository("User");

authRouter.post("/signin", async (req: express.Request, res: express.Response) =>
{
    const { username, password } = req.body;

    const user: HydratedDocument<IUser> | null = await userRepository.findOne({
        username,
        password
    });

    if (isNull(user))
    {
        throw new Error("404 user not found");
    }

    // Build the JWT payload
    const jwtPayload = {
        userId: user.id
    };
    // And sign it
    const jwt: string = jwtSign(jwtPayload, process.env.JWT_SECRET, {
        algorithm: "HS256",
        expiresIn: "1h",
        jwtid: uuidv4()
    });

    // Build the user's session if it doesn't exists
    if (userSessionsManager.hasUserSession(user.id) === false)
    {
        const userSessionFactory: UserSessionFactory = new UserSessionFactory(user.id);
        const userSession: UserSession = await userSessionFactory.buildUserSession();
        userSessionsManager.addUserSession(userSession);
    }

    res.json({
        accessToken: jwt
    });
})

.post("/signup", async (req: express.Request, res: express.Response) =>
{
    const { email, password, username } = req.body;
    const validationResult: ValidationResult = userRepository.insert({
        username,
        password,
        email
    });

    if (!validationResult.isValid)
    {
        throw validationResult.validationError;
    }

    // isFlushed: true => rend la prop data available, sinon elle vaut null

    // @TODO blinder
    const flushResult: FlushResult<IUser> = await userRepository.flush();
    const user: HydratedDocument<IUser> = flushResult.inserted[0];

    res.status(200).json({
        message: "User created, you can sign in"
    });
});
