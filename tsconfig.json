{
    "compilerOptions": {
        "outDir": "dist",
        "target": "es6",
        "strict": true,
        "moduleResolution": "node",
        "module": "commonjs",
        "plugins": [
            { "transform": "typescript-is/lib/transform-inline/transformer" }
        ],
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "strictNullChecks": true,
        "lib": [ "ES2020.String" ]
    },
    "include": [
        "src/**/*",
        "environment.d.ts"
    ]
}